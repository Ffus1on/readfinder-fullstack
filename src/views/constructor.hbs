<h2>Конструктор расписаний</h2>
<form id="schedule-form">
  <label for="date">Дата мероприятия:</label>
  <input type="date" id="date" name="date" required>

  <label for="time">Время:</label>
  <input type="time" id="time" name="time" required>

  <label for="event">Название мероприятия:</label>
  <input type="text" id="event" name="event" placeholder="Например, мастер-класс по чтению" required>

  <button type="submit" id="add">Добавить в расписание</button>
</form>

<h3>Ваше расписание:</h3>
<div id="schedule-container"></div>
