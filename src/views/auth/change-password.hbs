<div class="auth-page">
  <div class="auth-card">
    <h2>Смена пароля</h2>
    {{#if success}}
      <div class="auth-success">Пароль изменён. Остальные сессии завершены.</div>
    {{/if}}
    {{#if error}}
      {{#if (eq error 'server')}}<div class="auth-error">Ошибка сервера. Попробуйте позже</div>{{/if}}
    {{/if}}
    <form method="POST" action="/auth/change-password" class="auth-form">
      <div class="form-group">
        <label for="currentPassword">Текущий пароль</label>
        <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
        <span class="field-error{{#if (eq error 'current')}} visible{{/if}}">Неверный текущий пароль</span>
      </div>
      <div class="form-group">
        <label for="newPassword">Новый пароль</label>
        <input type="password" id="newPassword" name="newPassword" required data-password autocomplete="new-password">
        {{#unless (eq error 'password')}}<span class="password-hint">Минимум 8 символов, включая цифру</span>{{/unless}}
        <span class="field-error{{#if (eq error 'password')}} visible{{/if}}">Минимум 8 символов, включая цифру</span>
      </div>
      <button type="submit" class="btn btn-submit">Сменить пароль</button>
    </form>
    <p class="auth-link"><a href="/profile">Вернуться в профиль</a></p>
  </div>
</div>