<section id="events-section">
  <div class="events-header">
    <h2>{{event.title}}</h2>
    <a href="/events/{{event.id}}/edit{{#if user}}?auth=true{{/if}}" class="btn btn-edit">Редактировать</a>
  </div>

  <div class="event-card event-detail">
    {{#if event.description}}
    <span class="event-description">{{event.description}}</span>
    {{/if}}
    <span class="event-meta">Библиотека: {{event.library.name}}</span>
    <span class="event-meta">Организатор: {{event.creator.name}}</span>
    <div class="event-dates">
      <span class="date-badge">{{formatDateTime event.startTime}}</span>
      {{#if event.endTime}}
      <span class="date-badge">{{formatDateTime event.endTime}}</span>
      {{/if}}
    </div>
    <div class="event-actions">
      <form action="/events/{{event.id}}{{#if user}}?auth=true{{/if}}" method="POST" class="inline-form">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="btn btn-delete" onclick="return confirm('Удалить мероприятие?')">Удалить</button>
      </form>
      <a href="/events{{#if user}}?auth=true{{/if}}" class="btn btn-back">Назад к списку</a>
    </div>
  </div>
</section>
