generator client {
  provider = "prisma-client-js"
}

generator classGenerator {
  provider               = "prisma-class-generator"
  output                 = "../src/generated/prisma-class"
  separateRelationFields = true
  dryRun                 = false
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  FICTION
  NON_FICTION
  SCIENCE
  FANTASY
  DETECTIVE
  ROMANCE
  HORROR
  BIOGRAPHY
  HISTORY
}

enum WorkspaceType {
  individual
  group
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  favorites  Favorite[]
  events     LibraryEvent[]
}

model Book {
  id          String    @id @default(uuid())
  title       String
  author      String
  description String?
  image       String?
  pages       Int?
  rating      Float?
  category    Category?

  favorites    Favorite[]
  libraryBooks LibraryBook[]
}

model Library {
  id      String @id @default(uuid())
  name    String
  address String
  lat     Float?
  lng     Float?

  workspaces   Workspace[]
  events       LibraryEvent[]
  libraryBooks LibraryBook[]
}

model Favorite {
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

model LibraryBook {
  bookId    String
  libraryId String
  quantity  Int @default(1)

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@id([bookId, libraryId])
}

model Workspace {
  id          String        @id @default(uuid())
  libraryId   String
  type        WorkspaceType
  capacity    Int           @default(1)
  isAvailable Boolean       @default(true)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
}

model LibraryEvent {
  id          String    @id @default(uuid())
  libraryId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  creatorId   String

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}
