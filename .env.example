# Локальная разработка — PostgreSQL в Docker
DATABASE_URL="postgresql://readfinder:readfinder@localhost:5432/readfinder"

# Yandex Object Storage (S3-совместимое, ЛР 6). Заполнить после создания бакета.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# SuperTokens (ЛР 7). Заполнить после создания core-инстанса.
SUPERTOKENS_CONNECTION_URI=""
SUPERTOKENS_API_KEY=""
SUPERTOKENS_APP_NAME="ReadFinder"
SUPERTOKENS_API_DOMAIN="http://localhost:3000"
SUPERTOKENS_WEBSITE_DOMAIN="http://localhost:3000"
SUPERTOKENS_API_BASE_PATH="/api/auth"
SUPERTOKENS_WEBSITE_BASE_PATH="/auth"